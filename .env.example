# Copie este arquivo para .env e preencha os valores do seu projeto.
# Use supabase para contas individuais; demo para testar sem credenciais.
APP_MODE=demo
PORT=3001
SUPABASE_URL=
# Nova chave pública (sb_publishable_...) OU a chave anon legada abaixo.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Exclusiva para seed/importação. Nunca usar esta chave com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Alternativas públicas aceitas pela API, se você já utiliza esses nomes:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
